# Inspic environment variables
# Copy this file to .env.local and fill in values for your local environment.
# Do not commit .env.local or real secret values.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase client/server
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-only secret
# 코드는 SUPABASE_SECRET_KEY를 먼저 읽고, 없으면 SUPABASE_SERVICE_ROLE_KEY를 씁니다.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Toss Payments
# 결제 위젯은 브라우저에서 뜨므로 클라이언트 키는 NEXT_PUBLIC_ 이어야 합니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Toss webhook (선택). 설정하면 /api/payments/webhook이 헤더
# x-inspic-webhook-secret 또는 ?secret= 값을 대조합니다.
# 위조 방어의 본체는 이 값이 아니라 webhook이 Toss에 결제를 다시
# 물어보는 것입니다 — 본문은 신뢰하지 않습니다.
TOSS_WEBHOOK_SECRET=
