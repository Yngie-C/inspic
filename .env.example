# Inspic environment variables
# Copy this file to .env.local and fill in values for your local environment.
# Do not commit .env.local or real secret values.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase client/server
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-only secret
# 코드는 SUPABASE_SECRET_KEY를 먼저 읽고, 없으면 SUPABASE_SERVICE_ROLE_KEY를 씁니다.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Toss Payments
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
